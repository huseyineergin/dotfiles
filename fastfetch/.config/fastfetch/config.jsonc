{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "padding": {
      "top": 2,
      "right": 2
    }
  },
  "display": {
    "separator": "",
    "key": {
      "width": 18
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "┌─── SYSTEM ───────────────────────────────────────────────────────────┐"
    },
    {
      "type": "os",
      "key": "󰣇 OS"
    },
    {
      "type": "kernel",
      "key": "󰒓 Kernel"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime"
    },
    {
      "type": "shell",
      "key": "󰆍 Shell"
    },
    {
      "type": "terminal",
      "key": "󰆍 Terminal"
    },
    {
      "type": "custom",
      "format": "├─── HARDWARE ─────────────────────────────────────────────────────────┤"
    },
    {
      "type": "cpu",
      "key": "󰻠 CPU"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU"
    },
    {
      "type": "memory",
      "key": "󰍛 RAM"
    },
    {
      "type": "swap",
      "key": "󰓡 Swap"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk"
    },
    {
      "type": "custom",
      "format": "├─── DESKTOP ──────────────────────────────────────────────────────────┤"
    },
    {
      "type": "wm",
      "key": "󰖲 WM"
    },
    {
      "type": "de",
      "key": "󰧨 DE"
    },
    {
      "type": "theme",
      "key": "󰉼 Theme"
    },
    {
      "type": "icons",
      "key": "󰀻 Icons"
    },
    {
      "type": "cursor",
      "key": " Cursor"
    },
    {
      "type": "terminalfont",
      "key": " Terminal Font"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
